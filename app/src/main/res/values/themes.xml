<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DATINGAPP" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/rose_primary</item>
        <item name="colorPrimaryVariant">@color/rose_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color (Gold Accent). -->
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorSecondaryVariant">@color/gold_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Surface and Background -->
        <item name="colorSurface">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/rose_dark</item>
    </style>
</resources>
